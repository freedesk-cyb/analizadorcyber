# Configuración del Analizador de Ciberseguridad

# Groq Cloud API (Modelos Ultra-Rápidos OpenAI GPT-OSS 120B / 20B)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Claves API alternativas opcionales (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Configuración Opcional de OWASP ZAP Daemon
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# Puerto y Host del Servidor
PORT=8000
HOST=127.0.0.1
